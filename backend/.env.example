# =========================================================================
# LawDecoder Environment Configuration Example
# =========================================================================

# --- LLM Provider Selection ---
# Options: 'gemini', 'openrouter', or 'auto' (default: 'auto')
# - 'auto': Uses Gemini if GEMINI_API_KEY is present, else falls back to OpenRouter.
# - 'gemini': Uses Google Gemini directly. Requires GEMINI_API_KEY.
# - 'openrouter': Uses OpenRouter API. Requires at least one OPENROUTER_API_KEY.
LLM_PROVIDER=auto

# --- Google Gemini API Config ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- OpenRouter API Keys ---
# Add multiple keys for rotation (auto-rotated if multiple keys exist)
OPENROUTER_API_KEY1=your_first_openrouter_key_here
# OPENROUTER_API_KEY2=your_second_openrouter_key_here
# OPENROUTER_API_KEY3=your_third_openrouter_key_here

# --- Server Port Configuration ---
PORT=8000
